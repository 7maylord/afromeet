# Copy to .env (gitignored). Foundry auto-loads contracts/.env for `forge script`.

# Arc testnet RPC (Canteen-hosted; embeds your key — treat as secret).
ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/your_key

# Deployer key — funded with USDC for gas on Arc. Required.
PRIVATE_KEY=0xyour_deployer_private_key

# Optional overrides (sensible defaults applied if omitted):
#   USDC_ADDRESS         defaults to Arc system USDC 0x3600...0000
#   OPERATOR_ADDRESS     backend wallet that calls AccessEscrow.settle; defaults to deployer
#   CULTURAL_POOL_ADDRESS receives the 2% cultural cut; defaults to deployer
USDC_ADDRESS=0x3600000000000000000000000000000000000000
OPERATOR_ADDRESS=
CULTURAL_POOL_ADDRESS=
