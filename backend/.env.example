# --- Arc chain (needed to start) ---
# Canteen-hosted Arc testnet RPC. Embeds an API key — treat as secret.
# https://rpc.testnet.arc-node.thecanteenapp.com/v1/<your_key>
ARC_RPC_URL=

# --- Contracts (fill after deploying via contracts/script/DeployAfroMeet.s.sol) ---
# USDC defaults to Arc's system token if left blank.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
AFROMEET_NFT_ADDRESS=0x9A8c6Df48613265Ea2b90f1e4Dd85eC3Ca9A85DE
ACCESS_REGISTRY_ADDRESS=0x5363eACF9b04CAfcD1DDb0dc5365532644A1B46A
ACCESS_ESCROW_ADDRESS=0xB14a5927b20927A8812AC060c00CBE17772CcFA0
SPLIT_RESOLVER_ADDRESS=0x4cdd345EEFbfFE00F004C64Fe72da6EC667f8852
ROYALTY_ADDRESS=0x3D1A6E616CA3bc7fAb7cc178aF434071ddeAbC4f
MARKETPLACE_ADDRESS=0x892C2C0eD81f80Ba727af29c7A128A4A2e9d053c
FRACTIONAL_VAULT_FACTORY_ADDRESS=0xe41e15b91Ae30f3cB4f0193c4ca1f00c82342D8f

# --- Circle Developer-Controlled Wallets ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=        # set after first createWallet() run

# --- Patron Agent ---
ANTHROPIC_API_KEY=
AGENT_BUDGET_USDC=10
AGENT_MAX_PER_WORK_USDC=2        # max USDC the agent spends backing one work
AGENT_SAMPLE_LIMIT=3             # works sampled per run
AGENT_MODEL=claude-sonnet-4-6    # judgment model for the loop

# --- x402 services marketplace (Circle CLI) ---
# Defaults to Base Sepolia (free testnet USDC). Set SERVICES_CHAIN=BASE for mainnet (real USDC).
# Leave CIRCLE_SERVICES_WALLET empty to disable the services leg.
CIRCLE_SERVICES_WALLET=
SERVICES_CHAIN=BASE-SEPOLIA
SERVICES_MAX_USDC=0.05

# --- ERC-8004 agent identity ---
ERC8004_AGENT_ID=                # set after first auto-registration
ERC8004_METADATA_URI=ipfs://REPLACE_WITH_AGENT_METADATA

# Optional ERC-8004 registry overrides (defaults to standard Arc registries if left blank)
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION_REGISTRY_ADDRESS=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# --- Misc ---
PINATA_JWT=               # Pinata JWT for creator work uploads
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
MIN_ACCESS_SECONDS=30
PORT=3000
